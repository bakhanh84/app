// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── NextAuth Required Tables ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── SparkGo Models ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  theme         String    @default("pro")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  cars         Car[]
  chatSessions ChatSession[]
  reminders    MaintenanceReminder[]
}

model Car {
  id                String   @id @default(cuid())
  userId            String
  brand             String
  model             String
  year              Int
  currentKm         Int      @default(0)
  fuelType          String   @default("petrol")
  transmission      String   @default("auto")
  color             String?
  lastOilChangeKm   Int?
  lastOilChangeDate String?
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]
  reminders    MaintenanceReminder[]
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  carId     String?
  title     String   @default("Cuộc trò chuyện mới")
  theme     String   @default("pro")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  car      Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String   // "user" | "assistant"
  content     String
  attachments String?  // JSON: [{type, url, name, mimeType}]
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model MaintenanceReminder {
  id               String    @id @default(cuid())
  userId           String
  carId            String
  type             String    // "oil" | "brake" | "tire" | "registration" | "custom"
  label            String
  dueKm            Int?
  dueDate          DateTime?
  notified         Boolean   @default(false)
  pushSubscription String?   // JSON
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)
}
