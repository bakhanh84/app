// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}


datasource db {
  provider = "sqlite"
}

// ─── NextAuth Required Tables ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── SparkGo Models ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          String    @default("user") // "user" | "admin"
  theme         String    @default("light")
  goals         String?   // JSON: ["save_cost","understand_car","diy","reminder","diagnose","history"]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  cars             Car[]
  chatSessions     ChatSession[]
  reminders        MaintenanceReminder[]
  serviceRecords   ServiceRecord[]
  vehicleMemories  VehicleMemory[]
  vehicleDocuments VehicleDocument[]
}

model Car {
  id                String   @id @default(cuid())
  userId            String
  brand             String
  model             String
  year              Int
  licensePlate      String?
  vin               String?
  currentKm         Int      @default(0)
  dailyKmAvg        Int      @default(35)
  healthScore       Int      @default(85)
  fuelType          String   @default("petrol")
  transmission      String   @default("auto")
  color             String?
  lastOilChangeKm   Int?
  lastOilChangeDate String?
  lastServiceDate   String?
  notes             String?
  isActive          Boolean  @default(true)

  // Vehicle DNA fields
  dnaEngine       String   @default("unknown") // "good"|"monitor"|"urgent"|"unknown"
  dnaSuspension   String   @default("unknown")
  dnaBrakes       String   @default("unknown")
  dnaBattery      String   @default("unknown")
  dnaTires        String   @default("unknown")
  dnaElectrical   String   @default("unknown")

  // Ownership & cost
  purchaseDate     String?
  purchaseKm       Int?
  totalCost        Float    @default(0)

  // Documents
  insuranceExpiry    String?
  registrationExpiry String?

  // Completeness score (0–100)
  profileComplete  Int      @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSessions     ChatSession[]
  reminders        MaintenanceReminder[]
  serviceRecords   ServiceRecord[]
  vehicleMemories  VehicleMemory[]
  vehicleDocuments VehicleDocument[]
}

model ServiceRecord {
  id          String   @id @default(cuid())
  carId       String
  userId      String
  serviceDate DateTime @default(now())
  odometerKm  Int
  serviceName String
  serviceType String   @default("maintenance") // "maintenance"|"repair"|"inspection"|"parts"|"other"
  garageName  String?
  cost        Float?
  invoiceUrl  String?
  notes       String?
  createdAt   DateTime @default(now())

  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Vehicle Memory — AI nhớ về chiếc xe theo thời gian
model VehicleMemory {
  id         String   @id @default(cuid())
  carId      String
  userId     String
  memoryType String   // "oil_change"|"symptom"|"cost"|"garage"|"note"|"insight"|"repair"|"parts"|"inspection"
  title      String
  content    String   // JSON or plain text
  source     String   @default("manual") // "chat"|"manual"|"upload"|"ai_extracted"
  severity   String?  // "info"|"warning"|"urgent"
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Vehicle Documents — hóa đơn, giấy tờ xe
model VehicleDocument {
  id            String   @id @default(cuid())
  carId         String
  userId        String
  docType       String   // "invoice"|"registration"|"insurance"|"photo"|"quote"|"other"
  fileName      String
  url           String
  extractedData String?  // JSON extracted by AI OCR
  notes         String?
  uploadedAt    DateTime @default(now())

  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  carId     String?
  title     String   @default("Cuộc trò chuyện mới")
  theme     String   @default("light")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  car      Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String   // "user" | "assistant"
  content     String
  attachments String?  // JSON: [{type, url, name, mimeType}]
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model MaintenanceReminder {
  id               String    @id @default(cuid())
  userId           String
  carId            String
  type             String    // "oil"|"brake"|"tire"|"registration"|"insurance"|"battery"|"coolant"|"custom"
  label            String
  dueKm            Int?
  dueDate          DateTime?
  lastDoneKm       Int?
  lastDoneDate     DateTime?
  intervalKm       Int?      // repeat every X km
  intervalDays     Int?      // repeat every X days
  notified         Boolean   @default(false)
  pushSubscription String?   // JSON
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade)
}
